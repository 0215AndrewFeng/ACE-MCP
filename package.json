{
  "name": "ace-mcp",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Local code search MCP server for Java, JavaScript, .NET, and Python projects.",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "ace-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:web": "node dist/index.js --web-port 8787",
    "test": "node --import tsx --test src/core/search/queryAnalyzer.test.ts src/test/search-workflow.test.ts"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.21.1",
    "better-sqlite3": "^11.8.1",
    "iconv-lite": "^0.6.3",
    "ignore": "^7.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
